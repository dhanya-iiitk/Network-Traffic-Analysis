# ============================================
# CORRECTED FINAL SCORING
# Fix: invert flow scores, keep KNN normal
# ============================================

from sklearn.metrics import (
    roc_auc_score, roc_curve,
    classification_report, confusion_matrix
)
from sklearn.preprocessing import RobustScaler
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ── Correct combination: -flow + knn ─────────
fl_all_fix  = -fl_all     # ← inverted
knn_all_fix =  knn_all    # ← keep as is

a_fl  = roc_auc_score(y, fl_all_fix)
a_knn = roc_auc_score(y, knn_all_fix)

# Normalize
sc       = RobustScaler()
fl_norm  = sc.fit_transform(
    fl_all_fix.reshape(-1,1)
).flatten()
knn_norm = sc.fit_transform(
    knn_all_fix.reshape(-1,1)
).flatten()

# Find best weight
best_a, best_w = 0, 0.5
for w in np.arange(0.1, 1.0, 0.1):
    a = roc_auc_score(
        y, w*fl_norm + (1-w)*knn_norm
    )
    if a > best_a:
        best_a, best_w = a, w

ens   = best_w*fl_norm + (1-best_w)*knn_norm
a_ens = roc_auc_score(y, ens)

# Threshold + predictions
fpr, tpr, th = roc_curve(y, ens)
best_t = th[np.argmax(tpr - fpr)]
preds  = (ens >= best_t).astype(int)
acc    = (preds == y).mean()

print(f"\n{'='*55}")
print(f"  FINAL RESULTS — CIC-IoT-2023")
print(f"{'='*55}")
print(f"  Flow AUROC:     {a_fl:.4f}")
print(f"  KNN  AUROC:     {a_knn:.4f}")
print(f"  Ensemble AUROC: {a_ens:.4f}  ← FINAL 🎯")
print(f"  Accuracy:       {acc:.4f}")
print(f"  Weights: flow={best_w:.1f} knn={1-best_w:.1f}")
print(f"{'='*55}")
print(classification_report(
    y, preds,
    target_names=['Benign','DDoS-ICMP']
))

# ── Plots ─────────────────────────────────────
fig, axes = plt.subplots(1, 3, figsize=(18,5))
fig.suptitle(
    f'CIC-IoT-2023 Anomaly Detection'
    f'  AUROC = {a_ens:.4f}',
    fontsize=14, fontweight='bold'
)

cm = confusion_matrix(y, preds)
sns.heatmap(
    cm, annot=True, fmt='d',
    cmap='Blues', ax=axes[0],
    xticklabels=['Benign','DDoS'],
    yticklabels=['Benign','DDoS']
)
axes[0].set_title('Confusion Matrix')
axes[0].set_ylabel('True Label')
axes[0].set_xlabel('Predicted Label')

axes[1].hist(
    ens[y==0], bins=60, alpha=0.6,
    color='steelblue', label='Benign',
    density=True
)
axes[1].hist(
    ens[y==1], bins=60, alpha=0.6,
    color='crimson', label='DDoS-ICMP',
    density=True
)
axes[1].axvline(
    best_t, color='black',
    linestyle='--', linewidth=2,
    label=f'Threshold={best_t:.3f}'
)
axes[1].set_title('Score Distribution')
axes[1].set_xlabel('Anomaly Score')
axes[1].set_ylabel('Density')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

axes[2].plot(
    fpr, tpr, 'darkorange', linewidth=2,
    label=f'AUC = {a_ens:.4f}'
)
axes[2].plot(
    [0,1],[0,1],'navy',linestyle='--',
    label='Random (0.50)'
)
axes[2].fill_between(
    fpr, tpr, alpha=0.1, color='orange'
)
axes[2].set_title('ROC Curve')
axes[2].set_xlabel('False Positive Rate')
axes[2].set_ylabel('True Positive Rate')
axes[2].legend()
axes[2].grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig(
    f'{DRIVE_BASE}/final_results.png',
    dpi=150, bbox_inches='tight'
)
plt.show()
print("✅ Plots saved!")

